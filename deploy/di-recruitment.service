[Unit]
Description=D.I. Recruitment Next.js
After=network.target mysql.service

[Service]
Type=simple
User=diapp
Group=diapp
WorkingDirectory=/srv/di-recruitment
Environment=NODE_ENV=production
EnvironmentFile=/etc/di-recruitment.env
ExecStart=/usr/bin/node /srv/di-recruitment/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3001
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/di-recruitment/.next /var/lib/di-recruitment
UMask=0027

[Install]
WantedBy=multi-user.target
